# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
NODE_ENV=development

# Neon connection string (Neon > Connect, pooling on). Secret.
DATABASE_URL=

# Long random string used to sign login tokens (at least 32 characters). Secret.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend addresses allowed to call the API, comma separated, no trailing slash
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:5500

# Cloudflare Turnstile secret key. This is Cloudflare's always-pass TEST key for local work;
# the real key goes only in the Vercel dashboard.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Garden location for the Open-Meteo forecast (default: Cairo)
GARDEN_LATITUDE=30.0444
GARDEN_LONGITUDE=31.2357
